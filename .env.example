# Copy this file to .env before running Docker Compose.
# Never commit your real .env file.

APP_PORT=8080

POSTGRES_DB=tracking_bot
POSTGRES_USER=tracking_bot
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_PORT=5432

REDIS_PORT=6379

RABBITMQ_USER=tracking_bot
RABBITMQ_PASSWORD=change_me_rabbitmq_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret
TELEGRAM_ADMIN_CHAT_ID=replace_with_your_chat_id

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

CLEANUP_ENABLED=true
CLEANUP_INACTIVE_ALERT_RETENTION=30d
CLEANUP_CHART_FILE_RETENTION=1d
CLEANUP_DAILY_CRON="0 20 3 * * *"
CLEANUP_NEWS_CACHE_CRON="0 0 * * * *"
CLEANUP_ZONE=Asia/Ho_Chi_Minh
